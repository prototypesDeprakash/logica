public int maxProduct(int n) {
        int max1 = -1 , max2 = -1;
        while(n != 0){
            int rem = n % 10;
            if(max1 <= rem){
                max2 = max1;
                max1 = rem;
            }
            else if(max2 < rem){
                max2 = rem;
            }
            n /= 10;
        }
        return max1 * max2;
    }
//System.out.println(maxProduct(22));



// 2d matrix test
public int sumMatrix(int[][] matrix) {
    int total = 0;

    for (int i = 0; i < matrix.length; i++) {
        for (int j = 0; j < matrix[i].length; j++) {
            total += matrix[i][j];
        }
    }

    return total;
}

int[][] matrix = new int[3][4];

for (int i = 0; i < matrix.length; i++) {
    for (int j = 0; j < matrix[i].length; j++) {
        matrix[i][j] = (i + 1) * (j + 1);
    }
}

System.out.println("Matrix:");

for (int i = 0; i < matrix.length; i++) {
    for (int j = 0; j < matrix[i].length; j++) {
        System.out.print(matrix[i][j] + " ");
    }

    System.out.println();
}

System.out.println("Sum: " + sumMatrix(matrix));