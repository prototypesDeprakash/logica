boolean[][] visited = new boolean[10][10];

void dfs(int x, int y) {
    
    if(x < 0 || x >= 10 || y < 0 || y >= 10) {
        return;
    }

    if(visited[x][y]) {
        return;
    }

    visited[x][y] = true;

    // North
    if(y < 9) {
        move("North");
        dfs(x, y + 1);
        move("South");
    }

    // East
    if(x < 9) {
        move("East");
        dfs(x + 1, y);
        move("West");
    }

    // South
    if(y > 0) {
        move("South");
        dfs(x, y - 1);
        move("North");
    }

    // West
    if(x > 0) {
        move("West");
        dfs(x - 1, y);
        move("East");
    }
}

dfs(0, 0);